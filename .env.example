# ── LLM (provider-agnostic: any OpenAI-compatible chat API) ───────────────────
# Fill in the base URL, key and model for the provider you use, e.g.
#   OpenAI  https://api.openai.com/v1        Groq  https://api.groq.com/openai/v1
LLM_PROVIDER=
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1000
LLM_TIMEOUT=30

# ── Image model (OpenAI-compatible /images/generations endpoint) ──────────────
IMAGE_PROVIDER=
IMAGE_API_KEY=
IMAGE_BASE_URL=https://api.openai.com/v1
IMAGE_MODEL=
IMAGE_SIZE=1024x1024
IMAGE_TIMEOUT=120

# Supabase (backend uses the service-role key for writes + connector credentials)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Connector onboarding. Generate keys with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONNECTOR_ENCRYPTION_KEYS=          # comma-separated, newest first (rotation)
OAUTH_STATE_SECRET=                 # long random string
FRONTEND_URL=http://localhost:3000
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
META_WEBHOOK_VERIFY_TOKEN=
